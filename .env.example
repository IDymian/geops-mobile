# Copy this file to .env and fill in the values. Never commit .env.
# Run with: flutter run --dart-define-from-file=.env
#
# Everything here ends up inside the app binary, so only PUBLIC values
# belong here. Real secrets live in the backend (geops-api).

# --- Environment ---
APP_ENV=dev

# --- Backend ---
# Android emulator reaches the host machine at 10.0.2.2
API_BASE_URL=http://10.0.2.2:8080/api/v1

# --- Google Maps ---
# The Maps key is read by the native projects, not from this file:
#   Android: MAPS_API_KEY=... in android/local.properties (gitignored)
#   iOS:     MAPS_API_KEY = ... in ios/Flutter/Secrets.xcconfig (gitignored)
# Restrict the key in Google Cloud to the app's package name + SHA-1.

# --- Stripe (TEST mode publishable key: pk_test_...) ---
STRIPE_PUBLISHABLE_KEY=pk_test_change-me
